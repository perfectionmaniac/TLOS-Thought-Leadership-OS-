# Copy this file to .env and fill in your real values.
# Never commit the real .env file to GitHub.

# Anthropic (Claude) — powers orchestration, writing, review, research synthesis
ANTHROPIC_API_KEY=

# Perplexity (Agent API) — powers grounded/live web research for the Research Analyst step
PERPLEXITY_API_KEY=

# Telegram bot — how you talk to TLOS day to day (set up later, via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Path to the TLOS repo root (so the engine can find skills/, workflows/, engines/, reports/, knowledge/)
TLOS_REPO_ROOT=..
